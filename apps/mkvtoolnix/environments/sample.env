# MKVToolNix Environment Configuration
# Image: docker.io/jlesage/mkvtoolnix
# Source: https://github.com/jlesage/docker-mkvtoolnix
# Uses the jlesage GUI base image with web-based VNC/noVNC interface.
# Copy this file to local.env and override only the values you need.

# ── User/Group Settings ──────────────────────────────────────────────────────

# UID the app runs as (default: 1000)
USER_ID=1000

# GID the app runs as (default: 1000)
GROUP_ID=1000

# Supplementary group IDs, comma-separated (optional)
#SUP_GROUP_IDS=

# Umask for new files/dirs (default: 0022)
#UMASK=0022

# ── General Settings ─────────────────────────────────────────────────────────

# Timezone (default: Etc/UTC)
#TZ=Etc/UTC

# Locale / language (default: en_US.UTF-8)
#LANG=en_US.UTF-8

# Restart app automatically if it exits/crashes (default: 0)
#KEEP_APP_RUNNING=0

# Process priority / nice value: -20 (high) to 19 (low), default: 0
# Negative values require --cap-add=SYS_NICE
#APP_NICENESS=0

# ── Display Settings ─────────────────────────────────────────────────────────

# Virtual display resolution (pixels)
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

# Enable dark mode UI (default: 0)
DARK_MODE=1

# ── Web Interface Settings ───────────────────────────────────────────────────

# Web UI port (default: 5800)
#WEB_LISTENING_PORT=5800

# VNC port (default: 5900, set -1 to disable)
#VNC_LISTENING_PORT=5900

# VNC password (max 8 chars, or use /config/.vncpass_clear file)
#VNC_PASSWORD=

# Restrict web UI to localhost only (default: 0)
#WEB_LOCALHOST_ONLY=0

# Restrict VNC to localhost only (default: 0)
#VNC_LOCALHOST_ONLY=0

# ── Web Security ─────────────────────────────────────────────────────────────

# Enable HTTPS / encrypted VNC (default: 0)
#SECURE_CONNECTION=0

# Secure VNC method: SSL or TLS (default: SSL)
#SECURE_CONNECTION_VNC_METHOD=SSL

# Certificate change check interval in seconds (default: 60, 0 = off)
#SECURE_CONNECTION_CERTS_CHECK_INTERVAL=60

# Enable login page for web UI (requires HTTPS) (default: 0)
#WEB_AUTHENTICATION=0

# Web auth token lifetime in hours (default: 24)
#WEB_AUTHENTICATION_TOKEN_VALIDITY_TIME=24

# Single-user web auth credentials (optional; htpasswd preferred for multi-user)
#WEB_AUTHENTICATION_USERNAME=
#WEB_AUTHENTICATION_PASSWORD=

# ── Web Features ─────────────────────────────────────────────────────────────

# Stream app audio to browser (default: 0)
#WEB_AUDIO=0

# Web file manager in browser UI (default: 0)
#WEB_FILE_MANAGER=0

# Allowed paths for web file manager (default: AUTO)
#WEB_FILE_MANAGER_ALLOWED_PATHS=AUTO

# Denied paths for web file manager (overrides allowed)
#WEB_FILE_MANAGER_DENIED_PATHS=

# Desktop notifications in browser (requires HTTPS) (default: 0)
#WEB_NOTIFICATION=0

# Web terminal (HTTPS strongly recommended) (default: 0)
#WEB_TERMINAL=0

# ── Advanced Settings ─────────────────────────────────────────────────────────

# Enable debug logging (default: 0)
#CONTAINER_DEBUG=0

# Install additional Alpine packages at startup (space-separated)
#INSTALL_PACKAGES=

# Alpine mirror URL for package installs
#PACKAGES_MIRROR=

# Enable CJK font (WenQuanYi Zen Hei) (default: 0)
#ENABLE_CJK_FONT=0
