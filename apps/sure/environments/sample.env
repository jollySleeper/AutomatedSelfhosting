# Sure (Maybe Finance Fork) — Environment Configuration
# Image: ghcr.io/we-promise/sure:stable
# Source: https://github.com/we-promise/sure/blob/main/docs/hosting/docker.md
# Copy this file to local.env and override only the values you need.

# ── Rails Application ────────────────────────────────────────────────────────

# Secret key for Rails session encryption (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=changeme_generate_with_openssl_rand_hex_64

# ── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection (connects to sure-postgres in the pod)
POSTGRES_USER=sure
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sure
DATABASE_URL=postgres://sure:changeme@localhost:5432/sure

# ── Redis ────────────────────────────────────────────────────────────────────

# Redis connection (connects to sure-redis in the pod)
REDIS_URL=redis://localhost:6379/1

# ── Application Settings ─────────────────────────────────────────────────────

# Set to true when behind a reverse proxy with TLS termination
#RAILS_ASSUME_SSL=true

# Rails environment (default: production)
#RAILS_ENV=production

# Rails log level (default: info)
#RAILS_LOG_LEVEL=info

# ── AI Assistant (Optional) ──────────────────────────────────────────────────

# OpenAI-compatible API for AI assistant and auto-categorization
#OPENAI_ACCESS_TOKEN=sk-xxx
#OPENAI_URI_BASE=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4.1

# Assistant type: builtin (default) or external (for MCP/OpenClaw)
#ASSISTANT_TYPE=builtin

# ── Bank Sync (Optional) ────────────────────────────────────────────────────

# Plaid (US banks)
#PLAID_CLIENT_ID=
#PLAID_SECRET=
#PLAID_ENV=sandbox

# SimpleFIN (US/CA)
#SIMPLEFIN_SETUP_TOKEN=
