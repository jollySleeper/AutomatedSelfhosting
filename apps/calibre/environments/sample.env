# Calibre Environment Variables
# Copy this file to local.env and customize the values

# User ID - should match the user running the container
# NOTE: If not set, PUID will be automatically set to current user's ID ($(id -u))
# Uncomment and set manually if you need specific user ID
# PUID=1001

# Group ID - should match the group of the user running the container
# NOTE: If not set, PGID will be automatically set to current user's group ($(id -g))
# Uncomment and set manually if you need specific group ID
# PGID=1001

# Timezone - set to your local timezone
TZ=Etc/UTC

# Optional: Web interface password (leave empty for no password)
# PASSWORD=

# Optional: Additional Calibre command line arguments
# CLI_ARGS=

# Optional: Umask for running applications (default: 022)
# UMASK=022
