# Paperless-ngx Environment Configuration
# Image: ghcr.io/paperless-ngx/paperless-ngx
# Source: https://docs.paperless-ngx.com/configuration/
# Copy this file to local.env and override only the values you need.

# ── Required Settings ────────────────────────────────────────────────────────

# Redis broker URL (required for task scheduling, index maintenance, etc.)
# Format: redis://[password@]host:port[/db]
PAPERLESS_REDIS=redis://10.0.2.2:6379

# Secret key for Django session management and CSRF protection
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=changeme-generate-a-real-secret-key

# ── Database Settings ────────────────────────────────────────────────────────
# By default, Paperless uses SQLite. Set PAPERLESS_DBHOST to use PostgreSQL.

# Database engine: postgresql or mariadb (default: postgresql when DBHOST set)
#PAPERLESS_DBENGINE=postgresql

# Database host (unset = SQLite mode)
PAPERLESS_DBHOST=10.0.2.2

# Database port (default: 5432 for PostgreSQL, 3306 for MariaDB)
PAPERLESS_DBPORT=5432

# Database name (default: paperless)
PAPERLESS_DBNAME=paperless

# Database user (default: paperless)
PAPERLESS_DBUSER=paperless

# Database password
PAPERLESS_DBPASS=changeme

# Database connection timeout in seconds (default: unset)
#PAPERLESS_DB_TIMEOUT=

# Connection pool size for PostgreSQL (default: unset, uses Django default)
#PAPERLESS_DB_POOLSIZE=

# SSL mode for PostgreSQL connections (default: prefer)
# Options: disable, allow, prefer, require, verify-ca, verify-full
#PAPERLESS_DBSSLMODE=prefer

# ── Web Server ───────────────────────────────────────────────────────────────

# Full URL Paperless is hosted at, used for email links and CORS
# (default: unset; set when behind a reverse proxy with a custom domain)
#PAPERLESS_URL=https://paperless.aevion.lan

# Allowed hostnames for Django ALLOWED_HOSTS (comma-separated)
# (default: * — allows all; restrict in production)
#PAPERLESS_ALLOWED_HOSTS=paperless.aevion.lan,docs.aevion.lan

# CSRF trusted origins (comma-separated URLs including scheme)
# (default: unset; set when behind a reverse proxy)
#PAPERLESS_CSRF_TRUSTED_ORIGINS=http://paperless.aevion.lan

# Number of gunicorn web workers (default: 1)
# Increase for better concurrency on multi-core systems
#PAPERLESS_WEBSERVER_WORKERS=1

# Trusted proxy IPs for X-Forwarded-For header parsing (comma-separated CIDRs)
#PAPERLESS_TRUSTED_PROXIES=

# Use X-Forwarded-Host header (default: false; set true behind reverse proxy)
#PAPERLESS_USE_X_FORWARD_HOST=false

# Use X-Forwarded-Port header (default: false)
#PAPERLESS_USE_X_FORWARD_PORT=false

# ── Paths ────────────────────────────────────────────────────────────────────
# Typically not changed in Docker; controlled by volume mounts instead.

# Data directory for DB (SQLite), search index, classification model
# (default: ../data relative to Paperless src)
#PAPERLESS_DATA_DIR=/usr/src/paperless/data

# Media root for stored documents and thumbnails
# (default: ../media relative to Paperless src)
#PAPERLESS_MEDIA_ROOT=/usr/src/paperless/media

# Consumption directory — inbox for new files to be processed
# (default: ../consume relative to Paperless src)
#PAPERLESS_CONSUMPTION_DIR=/usr/src/paperless/consume

# Logging directory (default: PAPERLESS_DATA_DIR/log)
#PAPERLESS_LOGGING_DIR=

# Trash directory for soft-deleted documents (default: unset = permanent delete)
#PAPERLESS_EMPTY_TRASH_DIR=

# ── OCR Settings ─────────────────────────────────────────────────────────────

# Primary OCR language (ISO 639-2/T code, e.g. eng, deu, fra)
# (default: eng)
#PAPERLESS_OCR_LANGUAGE=eng

# Additional OCR languages to install (space-separated Tesseract packages)
# Example: PAPERLESS_OCR_LANGUAGES=deu fra hin
#PAPERLESS_OCR_LANGUAGES=

# OCR mode: skip, redo, force, skip_noarchive (default: skip)
# skip = only OCR pages without text layer
#PAPERLESS_OCR_MODE=skip

# Max pages to OCR (0 = all pages, default: 0)
#PAPERLESS_OCR_PAGES=0

# Clean input before OCR: clean, clean-final, none (default: clean)
# Set to "none" on low-power devices for faster processing
#PAPERLESS_OCR_CLEAN=clean

# ── Consumer Settings ────────────────────────────────────────────────────────

# Polling interval in seconds for consumption directory (0 = inotify)
# (default: 0; set >0 on network mounts or if inotify doesn't work)
#PAPERLESS_CONSUMER_POLLING=0

# Disable consumer entirely (default: false)
#PAPERLESS_CONSUMER_DISABLE=false

# Recursive consumption of subdirectories (default: false)
#PAPERLESS_CONSUMER_RECURSIVE=false

# Tag documents with subdirectory name (default: false)
#PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=false

# ── Task Processing ─────────────────────────────────────────────────────────

# Number of celery workers for document processing (default: 1)
#PAPERLESS_TASK_WORKERS=1

# Threads per worker (default: 1)
#PAPERLESS_THREADS_PER_WORKER=1

# ── User Mapping (non-rootless Docker) ───────────────────────────────────────

# UID to run as inside the container (default: 1000)
USERMAP_UID=1001

# GID to run as inside the container (default: 1000)
USERMAP_GID=1001

# ── Bootstrap Admin (optional, only on first run) ───────────────────────────

# Create admin user on first startup
#PAPERLESS_ADMIN_USER=admin

# Admin password (change immediately after first login)
#PAPERLESS_ADMIN_PASSWORD=

# Admin email
#PAPERLESS_ADMIN_MAIL=

# ── Tika / Gotenberg (optional, for Office docs and email parsing) ──────────

# Enable Tika integration for Office document support (default: false)
#PAPERLESS_TIKA_ENABLED=false

# Tika server URL
#PAPERLESS_TIKA_ENDPOINT=http://tika:9998

# Gotenberg server URL
#PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000

# ── Redis Cache (optional) ──────────────────────────────────────────────────

# Redis key prefix (useful when sharing one Redis instance across apps)
PAPERLESS_REDIS_PREFIX=paperless

# Separate Redis URL for read cache (default: unset, uses PAPERLESS_REDIS)
#PAPERLESS_READ_CACHE_REDIS_URL=

# Enable database read cache via Redis (default: false)
#PAPERLESS_DB_READ_CACHE_ENABLED=false

# Read cache TTL in seconds (default: 60)
#PAPERLESS_READ_CACHE_TTL=60

# ── Miscellaneous ────────────────────────────────────────────────────────────

# Timezone (default: UTC)
#PAPERLESS_TIME_ZONE=UTC

# Date display format in the UI (default: unset, uses browser locale)
#PAPERLESS_DATE_ORDER=DMY

# Filename date parsing order (default: unset)
#PAPERLESS_FILENAME_DATE_ORDER=

# Enable NLTK for language detection and auto-tagging (default: true)
# Disable on low-power devices to save resources
#PAPERLESS_ENABLE_NLTK=true
