[Unit]
Description=syncthing

[Container]
AutoUpdate=registry
ContainerName=syncthing
Group=1001
Image=docker.io/syncthing/syncthing:latest
PublishPort=127.0.0.1:8031:8384
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp
PublishPort=21027:21027/udp
User=1001
UserNS=keep-id
Volume=%h/selfhost/apps/syncthing/volumes/config:/var/syncthing/config
Volume=%h/selfhost:/home/selfhost
Volume=%h/media/Docs/Logseq:/home/docs/Logseq
Volume=%h/media/Songs:/home/songs

[Service]
Restart=always

[Install]
WantedBy=default.target
