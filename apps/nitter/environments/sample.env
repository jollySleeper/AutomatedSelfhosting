# Nitter (Twitter Frontend) Environment Configuration
# Image: varies (zedeus/nitter or forks)
# Source: https://github.com/zedeus/nitter
# Copy this file to nitter.env and override only the values you need.

# ── Twitter API Credentials (required) ────────────────────────────────────────

# Twitter/X account credentials for API access
TWITTER_USERNAME=changeme
TWITTER_PASSWORD=changeme

# Path to credentials file (alternative to username/password)
#TWITTER_CREDENTIALS_FILE=

# Guest accounts file for browsing without auth
NITTER_ACCOUNTS_FILE=/nitter-data/guest_accounts.json

# Reset nitter accounts file on startup
#RESET_NITTER_ACCOUNTS_FILE=

# ── Redis Configuration ──────────────────────────────────────────────────────

# Redis host (leave empty for embedded Redis or set for external)
#REDIS_HOST=
#REDIS_PORT=
#REDIS_PASSWORD=

# Disable Redis entirely
#DISABLE_REDIS=

# ── Instance Settings ─────────────────────────────────────────────────────────

# HTTP port (default: container's internal port)
#INSTANCE_PORT=

# Enable HTTPS
#INSTANCE_HTTPS=

# Instance hostname (e.g., nitter.aevion.lan)
#INSTANCE_HOSTNAME=

# Instance title shown in the browser tab
#INSTANCE_TITLE=

# UI theme
#INSTANCE_THEME=

# Enable infinite scrolling
#INSTANCE_INFINITE_SCROLL=

# Enable base64 encoding for media URLs
#INSTANCE_BASE64_MEDIA=

# ── RSS Settings ──────────────────────────────────────────────────────────────

# RSS feed refresh interval in minutes
#INSTANCE_RSS_MINUTES=

# Password for accessing RSS feeds
#INSTANCE_RSS_PASSWORD=changeme

# ── Web Authentication (optional) ─────────────────────────────────────────────

# Basic auth for the web interface
#INSTANCE_WEB_USERNAME=
#INSTANCE_WEB_PASSWORD=

# ── Debug Settings ────────────────────────────────────────────────────────────

#DEBUG=
#INSTANCE_ENABLE_DEBUG=

# ── Fly.io (not used in selfhost) ─────────────────────────────────────────────
#FLY_APP_NAME=

# ── Custom Config ─────────────────────────────────────────────────────────────

# Use a custom nitter.conf file instead of env vars
#USE_CUSTOM_CONF=
