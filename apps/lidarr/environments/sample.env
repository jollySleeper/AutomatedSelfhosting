# Lidarr Environment Configuration
# Source: https://docs.linuxserver.io/images/docker-lidarr/
#         https://wiki.servarr.com/lidarr/environment-variables
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Umask for new files/directories created by the container (optional)
#UMASK=022

# Docker Mods — pipe-separated list of LinuxServer mod images (optional)
#DOCKER_MODS=

# ── Servarr Override Variables (LIDARR__NAMESPACE__KEY) ────────────────────────

# Server port (default: 8686)
#LIDARR__SERVER__PORT=8686

# URL base path for reverse proxy (e.g., /lidarr)
#LIDARR__SERVER__URLBASE=

# Bind address (default: *)
#LIDARR__SERVER__BINDADDRESS=*

# API key (auto-generated on first run if not set)
#LIDARR__AUTH__APIKEY=

# Authentication method: None, Basic, Forms, External
#LIDARR__AUTH__METHOD=Forms

# Authentication required: Enabled, DisabledForLocalAddresses
#LIDARR__AUTH__REQUIRED=Enabled

# Log level: info, debug, trace
#LIDARR__LOG__LEVEL=info

# Instance name shown in the UI
#LIDARR__APP__INSTANCENAME=Lidarr

# UI theme: auto, dark, light
#LIDARR__APP__THEME=auto

# ── PostgreSQL Backend (optional, default is SQLite) ──────────────────────────
#LIDARR__POSTGRES__HOST=10.0.2.2
#LIDARR__POSTGRES__PORT=5432
#LIDARR__POSTGRES__USER=lidarr
#LIDARR__POSTGRES__PASSWORD=changeme
#LIDARR__POSTGRES__MAINDB=lidarr-main
#LIDARR__POSTGRES__LOGDB=lidarr-log

# ── SSL (optional) ───────────────────────────────────────────────────────────
#LIDARR__SERVER__ENABLESSL=false
#LIDARR__SERVER__SSLPORT=6969

# ── Update Settings ──────────────────────────────────────────────────────────
#LIDARR__UPDATE__MECHANISM=Docker
#LIDARR__UPDATE__AUTOMATICALLY=false
#LIDARR__UPDATE__BRANCH=main
