[Unit]
Description=lidarr

[Container]
AutoUpdate=registry
ContainerName=lidarr
EnvironmentFile=%h/selfhost/apps/lidarr/environments/local.env
Image=ghcr.io/linuxserver/lidarr:latest
Network=pasta:--map-host-loopback,10.0.2.2
PublishPort=127.0.0.1:8066:8066
Volume=%h/selfhost/apps/lidarr/volumes/config:/config
Volume=%h/media:/media

[Service]
Restart=always

[Install]
WantedBy=default.target
