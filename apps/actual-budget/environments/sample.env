# Actual Budget Environment Configuration
# Image: docker.io/actualbudget/actual-server
# Source: https://actualbudget.org/docs/config/
# Copy this file to local.env and override only the values you need.

# ── Server Settings ──────────────────────────────────────────────────────────

# Port the server listens on (default: 5006)
#ACTUAL_PORT=5006

# Hostname to bind to (default: :: for all interfaces)
#ACTUAL_HOSTNAME=::

# ── Data Directories ─────────────────────────────────────────────────────────

# Root data directory containing server-files, user-files, and config
# (default: /data if it exists, else process cwd)
#ACTUAL_DATA_DIR=/data

# Path to config.json (default: /data/config.json if /data exists)
#ACTUAL_CONFIG_PATH=/data/config.json

# Directory for server state files like account.sqlite
# (default: /data/server-files if /data exists)
#ACTUAL_SERVER_FILES=/data/server-files

# Directory for user budget files (binary blobs)
# (default: /data/user-files if /data exists)
#ACTUAL_USER_FILES=/data/user-files

# Custom web UI root (advanced, rarely needed)
#ACTUAL_WEB_ROOT=

# ── Upload Limits ────────────────────────────────────────────────────────────

# Max file size for sync uploads in MB (default: 20)
#ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20

# Max encrypted sync file size in MB (default: 50)
#ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SYNC_SIZE_LIMIT_MB=50

# General upload file size limit in MB (default: 20)
#ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20

# ── Authentication ───────────────────────────────────────────────────────────

# Login method: password, header, or openid (default: password)
#ACTUAL_LOGIN_METHOD=password

# Comma-separated allowed login methods (default: password,header,openid)
#ACTUAL_ALLOWED_LOGIN_METHODS=password

# ── Proxy / Rate Limiting ────────────────────────────────────────────────────

# Comma-separated CIDRs of trusted proxies for client IP detection
#ACTUAL_TRUSTED_PROXIES=

# Comma-separated CIDRs of trusted auth proxies (for header-based auth)
#ACTUAL_TRUSTED_AUTH_PROXIES=

# ── HTTPS (optional, typically handled by reverse proxy) ─────────────────────

# Path to HTTPS private key file
#ACTUAL_HTTPS_KEY=

# Path to HTTPS certificate file
#ACTUAL_HTTPS_CERT=
