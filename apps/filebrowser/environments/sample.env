# File Browser Environment Configuration
# Image: docker.io/filebrowser/filebrowser
# Source: https://filebrowser.org/cli/filebrowser
# All flags map to FB_ + UPPER_SNAKE_CASE of the flag name.
# Precedence: flags > env > config file > database > defaults
# Copy this file to local.env and override only the values you need.

# ── Server Settings ──────────────────────────────────────────────────────────

# Listen address (default: 127.0.0.1)
#FB_ADDRESS=0.0.0.0

# Listen port (default: 8080)
FB_PORT=8080

# Base URL / subpath prefix for reverse proxy (e.g., /filebrowser)
#FB_BASEURL=

# Root directory for file management (default: .)
#FB_ROOT=/srv

# ── Database & Config ─────────────────────────────────────────────────────────

# Bolt database path (default: ./filebrowser.db)
FB_DATABASE=/database/filebrowser.db

# Config file path (only loaded from file, no FB_ env var override exists)
#FB_CONFIG=/config/settings.json

# ── Security ──────────────────────────────────────────────────────────────────

# Disable authentication (not recommended for production)
# Default: false
#FB_NOAUTH=false

# First-run quick setup username (default: admin)
#FB_USERNAME=admin

# First-run quick setup password (hashed)
#FB_PASSWORD=

# Session token expiration time (default: 2h)
#FB_TOKEN_EXPIRATION_TIME=2h

# ── TLS Settings (optional) ──────────────────────────────────────────────────

# TLS certificate path
#FB_CERT=

# TLS private key path
#FB_KEY=

# ── Feature Toggles ──────────────────────────────────────────────────────────

# Disable Command Runner (default: true — commands disabled for security)
#FB_DISABLE_EXEC=true

# Disable image thumbnails (default: false)
#FB_DISABLE_THUMBNAILS=false

# Disable image preview resizing (default: false)
#FB_DISABLE_PREVIEW_RESIZE=false

# Skip image resolution calculation (default: false)
#FB_DISABLE_IMAGE_RESOLUTION_CALC=false

# Disable MIME detection via reading headers (default: false)
#FB_DISABLE_TYPE_DETECTION_BY_HEADER=false

# Number of image processor workers (default: 4)
#FB_IMAGE_PROCESSORS=4

# ── Caching ──────────────────────────────────────────────────────────────────

# File cache directory (empty = disabled)
#FB_CACHE_DIR=

# Redis URL for shared cache in multi-instance setups
#FB_REDIS_CACHE_URL=

# ── Logging ──────────────────────────────────────────────────────────────────

# Log output destination (default: stdout)
#FB_LOG=stdout

# ── Unix Socket (alternative to address/port) ─────────────────────────────────

# Unix socket path (mutually exclusive with address/port/TLS flags)
#FB_SOCKET=

# Unix socket file permissions (default: 438 octal)
#FB_SOCKET_PERM=438
