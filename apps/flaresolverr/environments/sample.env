# FlareSolverr Environment Configuration
# Image: ghcr.io/flaresolverr/flaresolverr
# Source: https://github.com/FlareSolverr/FlareSolverr
# Copy this file to local.env and override only the values you need.

# ── General Settings ──────────────────────────────────────────────────────────

# Timezone (tz database name)
TZ=Etc/UTC

# Log level: error, warning, info, debug
# Default: info
LOG_LEVEL=info

# Log to file in addition to stdout (path, optional)
#LOG_FILE=

# Log HTML content at debug level (very noisy, debugging only)
# Default: false
LOG_HTML=false

# ── Browser Settings ──────────────────────────────────────────────────────────

# Run Chrome in headless mode (set false to show browser window for debugging)
# Default: true
#HEADLESS=true

# Disable loading images/CSS/fonts to save bandwidth
# Default: false
#DISABLE_MEDIA=false

# Browser locale (e.g., en_GB, de_DE)
#LANG=

# URL used on startup to verify the browser works
# Default: https://www.google.com
#TEST_URL=https://www.google.com

# ── Network Settings ──────────────────────────────────────────────────────────

# Listen port for the HTTP API
# Default: 8191
#PORT=8191

# Listen address
# Default: 0.0.0.0
#HOST=0.0.0.0

# Default outbound proxy URL (used if request doesn't specify one)
#PROXY_URL=
#PROXY_USERNAME=
#PROXY_PASSWORD=

# ── Captcha Settings ─────────────────────────────────────────────────────────

# Captcha solver adapter name (largely non-functional in current versions)
# Default: none
CAPTCHA_SOLVER=none

# ── Prometheus Metrics (optional) ─────────────────────────────────────────────

# Enable Prometheus metrics endpoint
# Default: false
#PROMETHEUS_ENABLED=false

# Prometheus metrics port (only used if PROMETHEUS_ENABLED=true)
# Default: 8192
#PROMETHEUS_PORT=8192
