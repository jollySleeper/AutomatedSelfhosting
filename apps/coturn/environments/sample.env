# Coturn Environment Configuration
# Image: docker.io/coturn/coturn:4.18.0
# Sources:
# - https://github.com/coturn/coturn/tree/master/docker/coturn
# - https://github.com/schlagmichdoch/PairDrop/blob/master/docs/host-your-own.md
# Run scripts/generate-local-config.sh to create local.env and PairDrop's rtc_config.json.

# ── Authentication ───────────────────────────────────────────────────────────────

# Long-term credential username used only by PairDrop clients (required).
TURN_USERNAME=pairdrop

# Random long-term credential generated locally (required).
TURN_PASSWORD=changeme

# Authentication realm and local DNS name (required).
TURN_REALM=turn.aevion.lan
