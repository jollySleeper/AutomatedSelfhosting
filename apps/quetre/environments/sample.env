# Quetre (Quora Frontend) Environment Configuration
# Image: ghcr.io/zyachel/quetre or codeberg.org/zyachel/quetre
# Source: https://github.com/zyachel/quetre
# Copy this file to local.env and override only the values you need.

# ── General Settings ──────────────────────────────────────────────────────────

# Node environment: production or development
# In development mode, morgan middleware logs every request
NODE_ENV=production

# Listen port (default: 3000)
PORT=3000

# ── Caching Settings ─────────────────────────────────────────────────────────

# Duration for which static files' cached copies are valid in the browser
# Accepts: number (seconds), string (e.g., '1m', '2 days', '3600')
# Default: no caching if not set
#CACHE_PERIOD=1h

# ── HTTP Client Settings ─────────────────────────────────────────────────────

# User-Agent header that Quora will see
# Default: axios default
#AXIOS_USER_AGENT=axios/0.26.1

# Accept header for Quora requests
# Default: axios default
#AXIOS_ACCEPT=application/json, text/plain, */*

# ── Redis Caching (optional) ─────────────────────────────────────────────────

# Redis URL for caching API responses (if unset, no caching)
#REDIS_URL=localhost:6379

# Redis cache TTL in seconds (default: 3600)
#REDIS_TTL=3600

# ── Protocol Settings ────────────────────────────────────────────────────────

# Set to any value (e.g., 1, true) to prefer HTTP over HTTPS
# Useful for Tor, I2P, or other services where HTTP is preferred
# Leave blank/unset to use HTTPS upgrade
#NO_UPGRADE=1
