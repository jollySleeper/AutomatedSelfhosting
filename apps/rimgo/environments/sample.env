# rimgo (Imgur Frontend) Environment Configuration
# Image: codeberg.org/rimgo/rimgo (or quay.io/pussthecatorg/rimgo)
# Source: https://codeberg.org/rimgo/rimgo
# Copy this file to local.env and override only the values you need.

# ── Server Settings ──────────────────────────────────────────────────────────

# Listen address (default: 0.0.0.0)
ADDRESS=0.0.0.0

# Listen port (default: 3000)
PORT=3000

# Enable fiber prefork mode for multi-process (default: false)
FIBER_PREFORK=false

# ── Imgur API ─────────────────────────────────────────────────────────────────

# Imgur client ID for API access (required)
# Default public client ID: 546c25a59c58ad7
IMGUR_CLIENT_ID=546c25a59c58ad7

# ── Security ──────────────────────────────────────────────────────────────────

# Force HTTPS redirects (default: true)
# Set to false if behind a reverse proxy that handles SSL
SECURE=true

# ── Instance Privacy ──────────────────────────────────────────────────────────
# For more information: https://codeberg.org/librarian/librarian/wiki/Instance-privacy
# Required to be on the public instance list.

# Link to a privacy policy (optional)
#PRIVACY_POLICY=

# Explain how data is used/why it is collected (optional)
#PRIVACY_MESSAGE=

# Country where instance is located (leave blank for Tor-only instances)
#PRIVACY_COUNTRY=

# Hosting provider or ISP name (leave blank for Tor-only instances)
#PRIVACY_PROVIDER=

# Set to true if using Cloudflare proxy (gray cloud DNS-only = false)
PRIVACY_CLOUDFLARE=false

# Set to true if no data is collected at all (overrides all options below)
PRIVACY_NOT_COLLECTED=false

# Individual data collection flags (true = data IS collected)
PRIVACY_IP=true
PRIVACY_URL=true
PRIVACY_DEVICE=true

# Data only collected during error diagnostics and stored briefly
PRIVACY_DIAGNOSTICS=false
