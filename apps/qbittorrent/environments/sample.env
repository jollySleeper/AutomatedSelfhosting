# qBittorrent Environment Configuration
# Image: ghcr.io/linuxserver/qbittorrent
# Source: https://docs.linuxserver.io/images/docker-qbittorrent/
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
TZ=Etc/UTC

# Umask for new files/directories (optional)
#UMASK=022

# Docker Mods (optional)
#DOCKER_MODS=

# ── qBittorrent Settings ──────────────────────────────────────────────────────

# WebUI port INSIDE the container
# IMPORTANT: Must match both sides of the -p port mapping (e.g., -p 8061:8061)
# Mismatched ports cause 401 Unauthorized due to Host header validation in v5+
# Default: 8080
WEBUI_PORT=8080

# BitTorrent listening port for incoming connections (TCP + UDP)
# Should match the host-published port for active mode / port forwarding
# Default: 6881
#TORRENTING_PORT=6881
