# Seerr Environment Configuration
# Image: ghcr.io/seerr-team/seerr
# Source: https://docs.seerr.dev/
#         https://docs.seerr.dev/extending-seerr/database-config
# Copy this file to local.env and override only the values you need.

# ── General Settings ──────────────────────────────────────────────────────────

# Timezone
TZ=Etc/UTC

# Log level: error, warn, info, debug
# Default: debug
LOG_LEVEL=info

# HTTP listen port (default: 5055)
#PORT=5055

# Listen address (default: all interfaces)
#HOST=

# API key — if set, becomes the Seerr API key instead of a random one
# Treat as a secret (admin-level access)
#API_KEY=

# Config directory for settings.json, logs, and SQLite DB
# Default: config
#CONFIG_DIRECTORY=config

# ── Database Configuration ────────────────────────────────────────────────────
# Default is SQLite. Uncomment DB_TYPE=postgres to use PostgreSQL.

# Database type: sqlite (default) or postgres
#DB_TYPE=sqlite

# Log database queries (debugging)
#DB_LOG_QUERIES=false

# ── PostgreSQL (TCP) — only used when DB_TYPE=postgres ────────────────────────

#DB_HOST=10.0.2.2
#DB_PORT=5432
#DB_USER=seerr
#DB_PASS=changeme
#DB_NAME=seerr

# ── PostgreSQL (Unix socket) — alternative to TCP ─────────────────────────────

#DB_SOCKET_PATH=/var/run/postgresql

# ── PostgreSQL SSL (optional, only with DB_TYPE=postgres) ─────────────────────

#DB_USE_SSL=false
#DB_SSL_REJECT_UNAUTHORIZED=true
#DB_SSL_CA=
#DB_SSL_CA_FILE=
#DB_SSL_KEY=
#DB_SSL_KEY_FILE=
#DB_SSL_CERT=
#DB_SSL_CERT_FILE=
