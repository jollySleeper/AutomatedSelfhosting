# systemd-switch Environment Configuration
# Custom service management tool for toggling container services
# Copy this file to local.env and override only the values you need.

# Admin credentials for the web UI
ADMIN_USER=admin
ADMIN_PASS=changeme

# Comma-separated list of systemd user services that can be toggled
# These must match the service names under ~/.config/systemd/user/
ALLOWED_SERVICES=calibre,firefox,mkvtoolnix,filebrowser

# Listen address (use 127.0.0.1 for reverse proxy only)
HOST=127.0.0.1

# Listen port
PORT=8081

# Log level: error, warn, info, debug
LOG_LEVEL=info
