# Hyperpipe Environment Configuration
# Image: codeberg.org/hyperpipe/hyperpipe
# Source: https://codeberg.org/Hyperpipe/Hyperpipe/src/branch/main/docker/entrypoint.sh
# The entrypoint exits if either variable is unset. Values are bare hostnames
# (no scheme or path): they are substituted into the built frontend assets.
# Copy this file to local.env and override only the values you need.

# ── Backend APIs ─────────────────────────────────────────────────────────────

# Piped API hostname (replaces the upstream default pipedapi.kavin.rocks)
PIPED_API=piped-api.aevion.lan

# Hyperpipe backend hostname (replaces the upstream default hyperpipeapi.onrender.com)
HYP_API=hyperpipeapi.onrender.com
