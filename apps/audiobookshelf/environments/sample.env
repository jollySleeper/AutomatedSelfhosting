# Audiobookshelf Environment Configuration
# Image: ghcr.io/advplyr/audiobookshelf
# Source: https://www.audiobookshelf.org/docs
#         https://github.com/advplyr/audiobookshelf
# Copy this file to rootless.env (or local.env) and override only the values you need.

# ── Server Settings ──────────────────────────────────────────────────────────

# HTTP listen port (default: 8080 in container, or 13378 on host installs)
PORT=8080

# ── Authentication ────────────────────────────────────────────────────────────

# Token secret for JWT signing (auto-generated on first run if not set)
# If you lose this, all existing tokens become invalid
#TOKEN_SECRET=
