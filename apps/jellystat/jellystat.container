[Unit]
Description=jellystat

[Container]
AutoUpdate=registry
ContainerName=jellystat
EnvironmentFile=%h/selfhost/apps/jellystat/environments/local.env
Image=docker.io/cyfershepard/jellystat:latest
Network=pasta:--map-host-loopback,10.0.2.2
PublishPort=127.0.0.1:8069:3000
Volume=%h/selfhost/apps/jellystat/volumes/backup:/app/backend/backup-data

[Service]
Restart=always

[Install]
WantedBy=default.target
