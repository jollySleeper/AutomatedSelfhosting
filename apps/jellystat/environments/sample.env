# Jellystat Environment Configuration
# Image: docker.io/cyfershepard/jellystat
# Source: https://github.com/CyferShepard/Jellystat
# Copy this file to local.env and override only the values you need.

# ── General Settings ──────────────────────────────────────────────────────────

# Timezone (required for correct operation)
TZ=Etc/UTC

# ── Authentication ────────────────────────────────────────────────────────────

# Master admin username (only effective if BOTH JS_USER and JS_PASSWORD are set)
#JS_USER=sysadmin

# Master admin password
#JS_PASSWORD=changeme

# JWT signing secret (required — app exits if missing)
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme

# ── PostgreSQL Connection (required) ──────────────────────────────────────────

# PostgreSQL host (use 10.0.2.2 for host loopback via pasta's --map-host-loopback,10.0.2.2)
POSTGRES_IP=10.0.2.2

# PostgreSQL port
POSTGRES_PORT=5432

# PostgreSQL username
POSTGRES_USER=jellystat

# PostgreSQL password
POSTGRES_PASSWORD=changeme

# PostgreSQL database name (Jellystat expects "jfstat" by default)
# Note: This is NOT configurable via env — Jellystat hardcodes "jfstat"
# You must create the database as "jfstat": CREATE DATABASE jfstat OWNER jellystat;
#POSTGRES_DB=jfstat

# ── PostgreSQL SSL (optional) ─────────────────────────────────────────────────

# Enable SSL for PostgreSQL connection
#POSTGRES_SSL_ENABLED=false

# Reject unverified SSL certificates (e.g., self-signed)
# Default behavior when unset: true (strict verification)
#POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# ── Server Settings ──────────────────────────────────────────────────────────

# Listen address (default: 0.0.0.0)
#JS_LISTEN_IP=0.0.0.0

# URL base path for reverse proxy (e.g., /jellystat)
#JS_BASE_URL=/

# ── Playback Tracking ────────────────────────────────────────────────────────

# Minimum playback duration (seconds) to record a playback event
# Default: 1
#MINIMUM_SECONDS_TO_INCLUDE_PLAYBACK=1

# Max gap (hours) between sessions to treat as same watch session (1-12)
# Default: 1
#NEW_WATCH_EVENT_THRESHOLD_HOURS=1

# ── Emby Compatibility ───────────────────────────────────────────────────────

# Use Emby API paths instead of Jellyfin (for Emby users)
# Default: false
#IS_EMBY_API=false

# ── Advanced Settings ─────────────────────────────────────────────────────────

# Reject self-signed HTTPS certificates for outbound requests (axios/websocket)
# Default: true
#REJECT_SELF_SIGNED_CERTIFICATES=true

# Force HTTP session polling instead of websockets (Jellyfin >= 10.11.0)
# Default: unset (websockets used)
#JF_USE_WEBSOCKETS=true

# ── GeoIP (optional, for location-based analytics) ───────────────────────────

# MaxMind account ID for GeoLite2 database
#JS_GEOLITE_ACCOUNT_ID=

# MaxMind license key
#JS_GEOLITE_LICENSE_KEY=
