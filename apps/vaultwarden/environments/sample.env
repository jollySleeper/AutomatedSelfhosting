# Vaultwarden Environment Configuration
# Image: docker.io/vaultwarden/server:1.37.3
# Sources:
# - https://github.com/dani-garcia/vaultwarden/blob/1.37.3/.env.template
# - https://github.com/dani-garcia/vaultwarden/wiki
# Copy this file to local.env and override only the values you need.
#
# Podman reads env files literally: do NOT wrap values in quotes (the quotes
# become part of the value) and do NOT escape '$'. This differs from the
# upstream template and from docker-compose, which need quoting or '$$'.
#
# Settings saved from the /admin page are written to /data/config.json and
# take precedence over the values in this file.

# ── Server ──────────────────────────────────────────────────────────────────

# Public URL clients use to reach the vault. Required for the web vault,
# attachments, WebAuthn/passkeys and invitation links. Must be HTTPS.
# Default: (unset)
DOMAIN=https://vault.aevion.lan

# Listen port inside the container. The image default (80) needs root; this
# deployment runs unprivileged with --userns keep-id, so it must be >= 1024
# and match CONTAINER_PORT in podman-setup.sh.
# Default: 80 (in the container image)
ROCKET_PORT=8080

# Listen address inside the container (default: 0.0.0.0)
#ROCKET_ADDRESS=0.0.0.0

# Built-in TLS; not needed because NGINX terminates TLS (default: unset)
#ROCKET_TLS={certs="/path/to/certs.pem",key="/path/to/key.pem"}

# Rocket worker threads (default: number of CPU cores)
#ROCKET_WORKERS=

# ── Data Folders ────────────────────────────────────────────────────────────

# Main data folder (default: /data)
#DATA_FOLDER=/data

# Individual folders, these override DATA_FOLDER
#RSA_KEY_FILENAME=/data/rsa_key
#ICON_CACHE_FOLDER=/data/icon_cache
#ATTACHMENTS_FOLDER=/data/attachments
#SENDS_FOLDER=/data/sends
#TMP_FOLDER=/data/tmp
#TEMPLATES_FOLDER=/data/templates

# Reload HTML templates on every request, for development only (default: false)
#RELOAD_TEMPLATES=false

# Serve the bundled web vault (default: true)
#WEB_VAULT_ENABLED=true
#WEB_VAULT_FOLDER=web-vault/

# ── Database ────────────────────────────────────────────────────────────────

# SQLite is used by default at DATA_FOLDER/db.sqlite3.
# MySQL: mysql://user:password@host[:port]/database_name
# PostgreSQL: postgresql://user:password@host[:port]/database_name
# Default: sqlite:///data/db.sqlite3
#DATABASE_URL=sqlite:///data/db.sqlite3

# Enable SQLite write-ahead logging on startup (default: true)
#ENABLE_DB_WAL=true

# Connection retries on startup, 1 second apart; 0 retries forever (default: 15)
#DB_CONNECTION_RETRIES=15

# Seconds to wait when acquiring a connection (default: 30)
#DATABASE_TIMEOUT=30

# Seconds before idle connections are closed (default: 600)
#DATABASE_IDLE_TIMEOUT=600

# Connection pool size (defaults: min 2, max 10)
#DATABASE_MIN_CONNS=2
#DATABASE_MAX_CONNS=10

# SQL run on each new connection
# Default for SQLite: PRAGMA busy_timeout = 5000; PRAGMA synchronous = NORMAL;
#DATABASE_CONN_INIT=

# ── Registration & Invitations ──────────────────────────────────────────────

# Allow anyone who can reach the vault to create an account (default: true)
SIGNUPS_ALLOWED=false

# Require email verification at signup; needs SMTP (default: false)
#SIGNUPS_VERIFY=false
#SIGNUPS_VERIFY_RESEND_TIME=3600
#SIGNUPS_VERIFY_RESEND_LIMIT=6

# Comma-separated email domains that may register even when signups are
# disabled. When set, SIGNUPS_ALLOWED is ignored. (default: unset)
#SIGNUPS_DOMAINS_WHITELIST=example.com,example.net

# Allow organization admins to invite users even when signups are disabled.
# Without SMTP, invited users register at DOMAIN/#/signup. (default: true)
#INVITATIONS_ALLOWED=true

# Name shown in invitation emails (default: Vaultwarden)
#INVITATION_ORG_NAME=Vaultwarden

# Hours before invite, verification and deletion tokens expire (default: 120)
#INVITATION_EXPIRATION_HOURS=120

# ── Admin Panel ─────────────────────────────────────────────────────────────

# Token for the /admin page, preferably an Argon2id PHC string. If unset, the
# admin panel is disabled. Generate it with scripts/set-admin-token.sh, which
# writes the hash here. Never commit a real value.
# Default: (unset)
#ADMIN_TOKEN=$argon2id$v=19$m=65540,t=3,p=4$changeme$changeme

# Disable admin authentication entirely; only behind a separate auth layer
# (default: false)
#DISABLE_ADMIN_TOKEN=false

# Admin login rate limit: average seconds between attempts and burst size
# (defaults: 300 and 3)
#ADMIN_RATELIMIT_SECONDS=300
#ADMIN_RATELIMIT_MAX_BURST=3

# Admin session lifetime in minutes (default: 20)
#ADMIN_SESSION_LIFETIME=20

# ── Users & Vault Features ──────────────────────────────────────────────────

# Allow Bitwarden Sends (default: true)
#SENDS_ALLOWED=true

# Allow emergency access (default: true)
#EMERGENCY_ACCESS_ALLOWED=true

# Allow users to change their email (default: true)
#EMAIL_CHANGE_ALLOWED=true

# Server-side PBKDF2 iterations for new users (default: 600000)
#PASSWORD_ITERATIONS=600000

# Allow password hints (default: true)
#PASSWORD_HINTS_ALLOWED=true

# Show the hint on the web page when SMTP is not configured (default: false)
#SHOW_PASSWORD_HINT=false

# Who may create organizations: blank/all, none, or a list of emails
# (default: all)
#ORG_CREATION_USERS=

# Organization event logging (default: false)
#ORG_EVENTS_ENABLED=false

# Beta: organization groups (default: false)
#ORG_GROUPS_ENABLED=false

# Enforce Single Org before Reset Password policy (default: false)
#ENFORCE_SINGLE_ORG_WITH_RESET_PW_POLICY=false

# Raise secure note size limit from 10000 to 100000 (default: false)
#INCREASE_NOTE_SIZE_LIMIT=false

# Days before trashed items are deleted; unset keeps them (default: unset)
#TRASH_AUTO_DELETE_DAYS=

# Attachment and Send storage limits in KB (default: unlimited)
#ORG_ATTACHMENT_LIMIT=
#USER_ATTACHMENT_LIMIT=
#USER_SEND_LIMIT=

# HaveIBeenPwned API key for breach reports (default: unset)
#HIBP_API_KEY=

# Suppress client onboarding dialogs and upsell prompts (default: false)
#CLIENT_SUPPRESS_ONBOARDING=false

# Comma-separated experimental client feature flags (default: unset)
#EXPERIMENTAL_CLIENT_FEATURE_FLAGS=

# ── Notifications ───────────────────────────────────────────────────────────

# WebSocket notifications on the main port for web, desktop and browser
# extension clients (default: true)
#ENABLE_WEBSOCKET=true

# Mobile push notifications through Bitwarden's relay; requires an
# installation ID and key from https://bitwarden.com/host (default: false)
#PUSH_ENABLED=false
#PUSH_INSTALLATION_ID=changeme
#PUSH_INSTALLATION_KEY=changeme
#PUSH_RELAY_URI=https://push.bitwarden.com
#PUSH_IDENTITY_URI=https://identity.bitwarden.com

# ── Scheduled Jobs ──────────────────────────────────────────────────────────

# Cron-like schedules with seconds, always UTC. Blank disables a job.
#JOB_POLL_INTERVAL_MS=30000
#SEND_PURGE_SCHEDULE=0 5 * * * *
#TRASH_PURGE_SCHEDULE=0 5 0 * * *
#INCOMPLETE_2FA_SCHEDULE=30 * * * * *
#EMERGENCY_NOTIFICATION_REMINDER_SCHEDULE=0 3 * * * *
#EMERGENCY_REQUEST_TIMEOUT_SCHEDULE=0 7 * * * *
#EVENT_CLEANUP_SCHEDULE=0 10 0 * * *
#EVENTS_DAYS_RETAIN=
#AUTH_REQUEST_PURGE_SCHEDULE=30 * * * * *
#DUO_CONTEXT_PURGE_SCHEDULE=30 * * * * *
#PURGE_INCOMPLETE_SSO_AUTH=0 20 0 * * *

# ── Security & Rate Limits ──────────────────────────────────────────────────

# Header holding the client IP; set by NGINX (default: X-Real-IP)
#IP_HEADER=X-Real-IP

# Addresses allowed to set IP_HEADER; local covers NGINX on this host
# (default: local)
#IP_HEADER_TRUSTED_PROXIES=local

# Login rate limit: average seconds between attempts and burst size
# (defaults: 60 and 10)
#LOGIN_RATELIMIT_SECONDS=60
#LOGIN_RATELIMIT_MAX_BURST=10

# Rate limit for unauthenticated endpoints such as hints and Sends
# (defaults: 60 and 50)
#UNAUTHENTICATED_RATELIMIT_SECONDS=60
#UNAUTHENTICATED_RATELIMIT_MAX_BURST=50

# Minutes before an unfinished 2FA login counts as incomplete; 0 disables
# (default: 3)
#INCOMPLETE_2FA_TIME_LIMIT=3

# Extra CSP frame-ancestors and connect-src values (default: unset)
#ALLOWED_IFRAME_ANCESTORS=
#ALLOWED_CONNECT_SRC=

# Refuse outbound connections (icons, etc.) to non-global IPs (default: true)
#HTTP_REQUEST_BLOCK_NON_GLOBAL_IPS=true

# Regex of hosts the internal HTTP client must not fetch (default: unset)
#HTTP_REQUEST_BLOCK_REGEX=

# Resolve IPv6 first (default: false)
#DNS_PREFER_IPV6=false

# ── Website Icons ───────────────────────────────────────────────────────────

# internal, bitwarden, duckduckgo, google, or a URL template containing {}
# (default: internal)
#ICON_SERVICE=internal

# Redirect code for external icon services: 301, 302, 307 or 308 (default: 302)
#ICON_REDIRECT_CODE=302

# Stop downloading new icons; also set ICON_CACHE_TTL=0 (default: false)
#DISABLE_ICON_DOWNLOAD=false

# Icon cache TTLs in seconds; 0 is forever (defaults: 2592000 and 259200)
#ICON_CACHE_TTL=2592000
#ICON_CACHE_NEGTTL=259200

# Icon download timeout in seconds (default: 10)
#ICON_DOWNLOAD_TIMEOUT=10

# ── Two-Factor Authentication ───────────────────────────────────────────────

# Force a second factor on every login (default: false)
#DISABLE_2FA_REMEMBER=false

# Reject TOTP codes from the previous and next 30-second windows (default: false)
#AUTHENTICATOR_DISABLE_TIME_DRIFT=false

# Email 2FA; requires SMTP (defaults: 6 digits, 600 seconds, 3 attempts)
#EMAIL_TOKEN_SIZE=6
#EMAIL_EXPIRATION_TIME=600
#EMAIL_ATTEMPTS_LIMIT=3
#EMAIL_2FA_ENFORCE_ON_VERIFIED_INVITE=false
#EMAIL_2FA_AUTO_FALLBACK=false

# YubiKey OTP credentials from https://upgrade.yubico.com/getapikey/
#YUBICO_CLIENT_ID=changeme
#YUBICO_SECRET_KEY=changeme
#YUBICO_SERVER=

# Global Duo credentials (default: unset, users configure their own)
#DUO_IKEY=changeme
#DUO_SKEY=changeme
#DUO_HOST=changeme
#DUO_USE_IFRAME=false

# ── SSO (OpenID Connect) ────────────────────────────────────────────────────

# Log in through an OpenID Connect provider (default: false)
#SSO_ENABLED=false
#SSO_ONLY=false
#SSO_SIGNUPS_ALLOWED=true
#SSO_SIGNUPS_MATCH_EMAIL=true
#SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false
#SSO_AUTHORITY=https://auth.example.com
#SSO_SCOPES=email profile
#SSO_AUTHORIZE_EXTRA_PARAMS=
#SSO_PKCE=true
#SSO_AUDIENCE_TRUSTED=^$
#SSO_CLIENT_ID=changeme
#SSO_CLIENT_SECRET=changeme
#SSO_MASTER_PASSWORD_POLICY=
#SSO_AUTH_ONLY_NOT_SESSION=false
#SSO_CLIENT_CACHE_EXPIRATION=0
#SSO_DEBUG_TOKENS=false

# ── SMTP Email ──────────────────────────────────────────────────────────────

# Set SMTP_HOST and SMTP_FROM (or USE_SENDMAIL) to enable email.
# SMTP_SECURITY: starttls (port 587), force_tls (port 465) or off (port 25)
#SMTP_HOST=smtp.example.com
#SMTP_FROM=vaultwarden@example.com
#SMTP_FROM_NAME=Vaultwarden
#SMTP_USERNAME=changeme
#SMTP_PASSWORD=changeme
#SMTP_SECURITY=starttls
#SMTP_PORT=587
#SMTP_TIMEOUT=15
#SMTP_AUTH_MECHANISM=
#HELO_NAME=
#SMTP_EMBED_IMAGES=true
#SMTP_DEBUG=false
#SMTP_ACCEPT_INVALID_CERTS=false
#SMTP_ACCEPT_INVALID_HOSTNAMES=false
#USE_SENDMAIL=false
#SENDMAIL_COMMAND=

# Fail logins when the new-device email cannot be sent (default: false)
#REQUIRE_DEVICE_EMAIL=false

# ── Logging ─────────────────────────────────────────────────────────────────

# trace, debug, info, warn, error or off; per-module overrides allowed
# (default: info)
#LOG_LEVEL=info

# Timestamps and targets in log lines (default: true)
#EXTENDED_LOGGING=true
#LOG_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S.%3f

# Log to syslog or a file in addition to stdout (defaults: false, unset)
#USE_SYSLOG=false
#LOG_FILE=/data/vaultwarden.log

# ── Container Startup ───────────────────────────────────────────────────────

# File mode mask applied by /start.sh before launching (default: unset)
#UMASK=
