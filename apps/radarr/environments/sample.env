# Radarr Environment Configuration
# Source: https://docs.linuxserver.io/images/docker-radarr/
#         https://wiki.servarr.com/radarr/environment-variables
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Umask for new files/directories created by the container (optional)
#UMASK=022

# Docker Mods — pipe-separated list of LinuxServer mod images (optional)
# See: https://linuxserver.github.io/docker-mods/
#DOCKER_MODS=

# ── Servarr Override Variables (RADARR__NAMESPACE__KEY) ────────────────────────
# These override values in config.xml. Restart required after changes.

# Server port (default: 7878)
# Override to match your external port mapping for Host header validation
#RADARR__SERVER__PORT=7878

# URL base path for reverse proxy (e.g., /radarr)
#RADARR__SERVER__URLBASE=

# Bind address (default: *)
#RADARR__SERVER__BINDADDRESS=*

# API key (auto-generated on first run if not set)
#RADARR__AUTH__APIKEY=

# Authentication method: None, Basic, Forms, External
#RADARR__AUTH__METHOD=Forms

# Authentication required: Enabled, DisabledForLocalAddresses
#RADARR__AUTH__REQUIRED=Enabled

# Log level: info, debug, trace
#RADARR__LOG__LEVEL=info

# Instance name shown in the UI
#RADARR__APP__INSTANCENAME=Radarr

# UI theme: auto, dark, light
#RADARR__APP__THEME=auto

# ── PostgreSQL Backend (optional, default is SQLite) ──────────────────────────
#RADARR__POSTGRES__HOST=10.0.2.2
#RADARR__POSTGRES__PORT=5432
#RADARR__POSTGRES__USER=radarr
#RADARR__POSTGRES__PASSWORD=changeme
#RADARR__POSTGRES__MAINDB=radarr-main
#RADARR__POSTGRES__LOGDB=radarr-log

# ── SSL (optional) ───────────────────────────────────────────────────────────
#RADARR__SERVER__ENABLESSL=false
#RADARR__SERVER__SSLPORT=9899

# ── Update Settings ──────────────────────────────────────────────────────────
#RADARR__UPDATE__MECHANISM=Docker
#RADARR__UPDATE__AUTOMATICALLY=false
#RADARR__UPDATE__BRANCH=main
