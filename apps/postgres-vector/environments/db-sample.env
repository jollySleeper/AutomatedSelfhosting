# PostgreSQL Vector Database Environment Configuration
# Image: docker.io/tensorchord/pgvecto-rs:pg16-v0.2.1
# Source: https://hub.docker.com/_/postgres (base), https://github.com/tensorchord/pgvecto.rs (extension)
# Copy this file to db.env and set your actual credentials.

# ── Superuser Credentials ────────────────────────────────────────────────────

# PostgreSQL superuser name (used for administration and multi-db creation)
POSTGRES_USER=postgresql

# PostgreSQL superuser password
POSTGRES_PASSWORD=changeme

# ── Initialization ───────────────────────────────────────────────────────────

# Arguments passed to initdb during first-time database creation
# --data-checksums enables page-level checksums for data integrity detection
POSTGRES_INITDB_ARGS=--data-checksums

# ── Multi-Database Setup ─────────────────────────────────────────────────────
# Format: database,user,password separated by colons for multiple databases
# The multi-db-entrypoint.sh script parses this and creates each DB + user.
#
# Current databases:
#   piped     — YouTube proxy service (Piped)
#   immich    — Photo management with AI (Immich)
#   wger      — Workout/fitness tracking (Wger)
#   jellystat — Jellyfin usage analytics (Jellystat, DB name: jfstat)
#   paperless — Document management system (Paperless-ngx)
#
POSTGRES_MULTIPLE_DATABASES=piped,piped,changeme:immich,immich,changeme:wger,wger,changeme:jellystat,jellystat,changeme:paperless,paperless,changeme

# ── Manual Database Creation ─────────────────────────────────────────────────
# If the instance is already running and you need to add a new database:
#
# Step 1: Create database
#   podman exec -it postgres-vector psql -U postgresql -d postgres -c "CREATE DATABASE newdb;"
#
# Step 2: Create user and grant permissions
#   podman exec -it postgres-vector psql -U postgresql -d postgres -c "
#   CREATE USER newuser WITH PASSWORD 'password';
#   GRANT ALL PRIVILEGES ON DATABASE newdb TO newuser;
#   ALTER DATABASE newdb OWNER TO newuser;
#   GRANT USAGE ON SCHEMA public TO newuser;
#   "
#
# Important: After dropping default 'postgresql' database, always specify target db:
#   podman exec -it postgres-vector psql -U postgresql -d postgres -c "..."
