# GoatSync Environment Configuration (Sample)
# Copy this file to local.env and update the values
#
# Reference: https://github.com/jollySleeper/GoatSync/.env.example

# ═══════════════════════════════════════════════════════════
# REQUIRED - Must be set for production
# ═══════════════════════════════════════════════════════════

# PostgreSQL connection string (required)
# Uses shared postgres-vector service (accessible at 10.0.2.2:5432 from container)
# Format: postgres://user:password@host:port/database?sslmode=disable
# Generate password with: openssl rand -base64 16
DATABASE_URL=postgres://goatsync:CHANGE_ME@10.0.2.2:5432/goatsync?sslmode=disable

# Encryption secret for login challenge encryption (required, min 32 characters)
# Generate with: openssl rand -base64 32
ENCRYPTION_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ═══════════════════════════════════════════════════════════
# OPTIONAL - Server Settings
# ═══════════════════════════════════════════════════════════

# Server port (default: 3735)
# PORT=3735

# Enable debug mode (default: false)
# DEBUG=false

# Gin web framework mode: debug, release, test (default: release)
# GIN_MODE=release

# ═══════════════════════════════════════════════════════════
# OPTIONAL - Redis (for real-time WebSocket sync)
# ═══════════════════════════════════════════════════════════

# Redis URL for WebSocket pub/sub (using database 1 to avoid conflicts with other apps)
# REDIS_URL=redis://10.0.2.2:6379/1

# ═══════════════════════════════════════════════════════════
# OPTIONAL - Security Settings
# ═══════════════════════════════════════════════════════════

# How long login challenges are valid in seconds (default: 300)
# CHALLENGE_VALID_SECONDS=300

# CORS allowed origins, comma-separated (default: *)
# ALLOWED_ORIGINS=https://your-domain.com

# Allowed Host headers, comma-separated (default: *)
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# ═══════════════════════════════════════════════════════════
# OPTIONAL - Storage Paths
# ═══════════════════════════════════════════════════════════

# Chunk storage directory - stores encrypted binary data
# Default: /data/chunks (mapped to volumes/chunks on host)
# CHUNK_STORAGE_PATH=/data/chunks
