# Sonarr Environment Configuration
# Source: https://docs.linuxserver.io/images/docker-sonarr/
#         https://wiki.servarr.com/sonarr/environment-variables
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Umask for new files/directories created by the container (optional)
#UMASK=022

# Docker Mods — pipe-separated list of LinuxServer mod images (optional)
#DOCKER_MODS=

# ── Servarr Override Variables (SONARR__NAMESPACE__KEY) ────────────────────────

# Server port (default: 8989)
#SONARR__SERVER__PORT=8989

# URL base path for reverse proxy (e.g., /sonarr)
#SONARR__SERVER__URLBASE=

# Bind address (default: *)
#SONARR__SERVER__BINDADDRESS=*

# API key (auto-generated on first run if not set)
#SONARR__AUTH__APIKEY=

# Authentication method: None, Basic, Forms, External
#SONARR__AUTH__METHOD=Forms

# Authentication required: Enabled, DisabledForLocalAddresses
#SONARR__AUTH__REQUIRED=Enabled

# Log level: info, debug, trace
#SONARR__LOG__LEVEL=info

# Instance name shown in the UI
#SONARR__APP__INSTANCENAME=Sonarr

# UI theme: auto, dark, light
#SONARR__APP__THEME=auto

# ── PostgreSQL Backend (optional, default is SQLite) ──────────────────────────
#SONARR__POSTGRES__HOST=10.0.2.2
#SONARR__POSTGRES__PORT=5432
#SONARR__POSTGRES__USER=sonarr
#SONARR__POSTGRES__PASSWORD=changeme
#SONARR__POSTGRES__MAINDB=sonarr-main
#SONARR__POSTGRES__LOGDB=sonarr-log

# ── SSL (optional) ───────────────────────────────────────────────────────────
#SONARR__SERVER__ENABLESSL=false
#SONARR__SERVER__SSLPORT=9898

# ── Update Settings ──────────────────────────────────────────────────────────
#SONARR__UPDATE__MECHANISM=Docker
#SONARR__UPDATE__AUTOMATICALLY=false
#SONARR__UPDATE__BRANCH=main
