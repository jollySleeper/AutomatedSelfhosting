# Calibre-Web-Automated Environment Configuration
# Copy this file to local.env and modify as needed

# User/Group IDs (Required)
PUID=1000
PGID=1000

# Timezone (Required)
TZ=UTC

# Application Settings
# APP_DB_ROOT: Path to store application database (inside container)
# Default: /config

# TARGET_FORMAT: Default target format for automatic conversion
# Options: epub, mobi, pdf, etc.
# Default: epub

# REQ_FINISH: Require books to finish downloading before processing
# Default: True

# GOOGLE_API_KEY: For Google Books metadata provider (optional)
# Leave empty if not using

# SMTP Settings (for email features - optional)
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_LOGIN=
# SMTP_PASSWORD=
# SMTP_FROM=

# Advanced Settings
# UPLOAD_MAX_SIZE: Maximum upload size in MB
# Default: 100

# SESSION_TIMEOUT: Session timeout in minutes
# Default: 60

# DEVELOPMENT: Enable development mode (not recommended for production)
# Default: False

# Network Share Mode (set to true if deploying on NFS/SMB)
# NETWORK_SHARE_MODE=false
