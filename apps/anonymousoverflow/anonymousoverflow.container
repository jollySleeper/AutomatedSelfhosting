[Unit]
Description=anonymousoverflow
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
AutoUpdate=registry
ContainerName=anonymousoverflow
Image=ghcr.io/httpjamesm/anonymousoverflow:release
EnvironmentFile=%h/selfhost/apps/anonymousoverflow/environments/local.env
Userns=keep-id
Network=pasta
PublishPort=127.0.0.1:8011:8080/tcp
Secret=jwt_signing_secret,type=env,target=JWT_SIGNING_SECRET
HealthCmd=/bin/sh -c 'kill -0 1'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
