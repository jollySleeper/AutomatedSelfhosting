# PairDrop Environment Configuration
# Image: lscr.io/linuxserver/pairdrop:1.11.2
# Sources:
# - https://docs.linuxserver.io/images/docker-pairdrop/
# - https://github.com/schlagmichdoch/PairDrop/blob/master/docs/host-your-own.md
# Copy this file to local.env and override only the values you need.

# ── User & System ─────────────────────────────────────────────────────────────

# User ID for file permissions (default: 1000)
PUID=1001

# Group ID for file permissions (default: 1000)
PGID=1001

# Timezone (default: Etc/UTC)
TZ=Etc/UTC

# ── Network & Transfer Settings ──────────────────────────────────────────────

# Provide PairDrop clients with its application-level WebSocket relay only when
# WebRTC is completely unavailable. This is not a true ICE-failure fallback in
# PairDrop v1.11.2 and does not have WebRTC's peer-to-peer transport encryption.
# Default: false
#WS_FALLBACK=false

# Limit requests per 5 minutes to prevent abuse (default: false)
# Can be true or an integer representing the proxy hop depth (e.g., 1)
# Default: false
RATE_LIMIT=false

# Path to the generated private Coturn STUN/TURN configuration JSON file.
# Local deployment value: /config/rtc_config.json
# Default: false (uses default Google STUN server stun:stun.l.google.com:19302)
#RTC_CONFIG=/config/rtc_config.json

# Number of IPv6 hextets (1-7) to match client IP against for peer auto-discovery
# Common value is 4 (matches within the same /64 subnet)
# Default: false
#IPV6_LOCALIZE=4

# Use an external signaling server if hosting only client files
# Example: pairdrop.net or custom signaling domain without protocol prefix
# Default: false
#SIGNALING_SERVER=false

# ── Debugging ─────────────────────────────────────────────────────────────────

# Enable debug mode to print connecting peer IP addresses and env vars to stdout
# WARNING: Do not enable in production to preserve privacy
# Default: false
DEBUG_MODE=false

# ── UI Customization Buttons (About PairDrop Page) ────────────────────────────

# Donation button visibility (default: true)
#DONATION_BUTTON_ACTIVE=false

# Donation button URL
#DONATION_BUTTON_LINK=https://www.buymeacoffee.com/pairdrop

# Donation button hover title
#DONATION_BUTTON_TITLE=Buy me a coffee

# Twitter/X button visibility (default: true)
#TWITTER_BUTTON_ACTIVE=false

# Twitter/X profile link
#TWITTER_BUTTON_LINK=https://twitter.com/account

# Twitter/X button hover title
#TWITTER_BUTTON_TITLE=Find me on Twitter

# Mastodon button visibility (default: false)
#MASTODON_BUTTON_ACTIVE=false

# Mastodon profile link
#MASTODON_BUTTON_LINK=https://mastodon.social/account

# Mastodon button hover title
#MASTODON_BUTTON_TITLE=Find me on Mastodon

# Bluesky button visibility (default: false)
#BLUESKY_BUTTON_ACTIVE=false

# Bluesky profile link
#BLUESKY_BUTTON_LINK=https://bsky.app/profile/account

# Bluesky button hover title
#BLUESKY_BUTTON_TITLE=Find me on Bluesky

# Custom social button visibility (default: false)
#CUSTOM_BUTTON_ACTIVE=false

# Custom social button link
#CUSTOM_BUTTON_LINK=https://your-custom-social-network.net/account

# Custom social button hover title
#CUSTOM_BUTTON_TITLE=Find me on this custom social network

# Privacy policy button visibility (default: false)
#PRIVACYPOLICY_BUTTON_ACTIVE=false

# Privacy policy link
#PRIVACYPOLICY_BUTTON_LINK=https://link-to-your-privacy-policy.net

# Privacy policy hover title
#PRIVACYPOLICY_BUTTON_TITLE=Open our privacy policy
