# Beaver Habits Tracker Environment Configuration
# Based on options from: https://github.com/daya0576/beaverhabits/wiki/Development#self-hosting

# Storage Options
# DATABASE: stores everything in a single SQLite database file named habits.db
# USER_DISK: saves habits and records in local json files
HABITS_STORAGE=USER_DISK

# Week Configuration
# By default, the first day of the week is Monday (0)
# To change it to Sunday, set it to 6
FIRST_DAY_OF_WEEK=0

# User Management
# Setting this to 1 prevents others from signing up in the future
# Comment out or set to higher number to allow multiple users
MAX_USER_COUNT=1

# iOS Features
# Experimental feature to enable standalone mode on iOS
# Default: true
ENABLE_IOS_STANDALONE=true

# Index Page Display Options
# Display total completed count along with habit name on index page
# Default: false
INDEX_SHOW_HABIT_COUNT=false

# Display current streak along with habit name on index page
# Default: false
INDEX_SHOW_HABIT_STREAK=false

# UI Customization
# Customize the habit name column size for the index page
# Default: 5
INDEX_HABIT_NAME_COLUMNS=5

# Customize the displayed dates for the index page
# Default: 5
INDEX_HABIT_DATE_COLUMNS=5

# Authentication Options
# Delegate authentication to an authenticating reverse proxy
# Pass user's email in HTTP headers (e.g., Cf-Access-Authenticated-User-Email)
# Requires an existing account
# TRUSTED_EMAIL_HEADER=

# Disable login page entirely - creates account with specified email if it doesn't exist
# TRUSTED_LOCAL_EMAIL=your@email.com

# Display Options
# Reverse the order of dates displayed
# Default: false
INDEX_HABIT_DATE_REVERSE=false

# Analytics (Optional)
# Umami analytics tracking ID - leave empty to disable tracking
# UMAMI_ANALYTICS_ID=

# Umami analytics script URL
# Default: https://cloud.umami.is/script.js
# UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Theme Options
# Dark mode setting
# Default: None (auto mode)
# DARK_MODE=
