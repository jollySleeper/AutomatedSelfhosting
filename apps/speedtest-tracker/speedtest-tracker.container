[Unit]
Description=speedtest-tracker

[Container]
AutoUpdate=registry
ContainerName=speedtest-tracker
EnvironmentFile=%h/selfhost/apps/speedtest-tracker/environments/speedtest.env
Image=lscr.io/linuxserver/speedtest-tracker:latest
PublishPort=127.0.0.1:8054:80
Volume=%h/selfhost/apps/speedtest-tracker/volumes/config:/config

[Service]
Restart=always

[Install]
WantedBy=default.target
