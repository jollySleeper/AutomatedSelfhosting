# Speedtest Tracker Sample Environment Configuration
# Copy this file to create your local.env and customize the values
# Documentation: https://docs.speedtest-tracker.dev/getting-started/environment-variables

# ===================================================================
# APPLICATION CONFIGURATION
# ===================================================================

# Container User/Group IDs - Set the user and group the container should run as
PUID=1000
PGID=1000

# Laravel Application Key (REQUIRED) - 32-character key for encryption/decryption
# Generate with: openssl rand -base64 32 (include the 'base64:' prefix)
# APP_KEY=base64:YOUR_GENERATED_KEY_HERE

# Application Settings
APP_NAME=Speedtest Tracker  # Name shown in dashboard and notifications
# APP_URL=https://speedtest.aevion.lan  # Base URL for links in emails
# ASSET_URL=https://speedtest.aevion.lan  # URL for static assets (needed with reverse proxy)
APP_TIMEZONE=UTC  # Application timezone (should match database timezone)
DISPLAY_TIMEZONE=America/New_York  # How to display timestamps in the UI
CONTENT_WIDTH=7xl  # Width of content area (Filament framework values)
PUBLIC_DASHBOARD=false  # Allow unauthenticated access to dashboard

# Admin User (Only effective during initial setup)
# ADMIN_NAME=Admin  # Initial admin username
# ADMIN_EMAIL=admin@example.com  # Initial admin email
# ADMIN_PASSWORD=changeme  # Initial admin password

# Security - Restrict access to specific IP addresses
# ALLOWED_IPS=127.0.0.1,10.0.0.0/8

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# SQLite (Recommended for simple deployments) - Self-contained, no external DB needed
DB_CONNECTION=sqlite  # Database driver: sqlite or pgsql
DB_DATABASE=/config/database.sqlite  # Path to SQLite database file

# PostgreSQL (Alternative - requires external database setup)
# DB_CONNECTION=pgsql  # Use PostgreSQL instead of SQLite
# DB_HOST=postgres-vector  # Database host (your postgres container name)
# DB_PORT=5432  # Database port
# DB_DATABASE=speedtest  # Database name
# DB_USERNAME=speedtest  # Database username
# DB_PASSWORD=password  # Database password

# ===================================================================
# SPEEDTEST CONFIGURATION
# ===================================================================

# Schedule (Cron expression) - When to automatically run speedtests
# Format: "minute hour day month day-of-week"
# Examples: "0 */1 * * *" (every hour), "*/30 * * * *" (every 30 mins), "0 9,14,19 * * *" (3x daily)
# IMPORTANT: No inline comments after values - they break parsing!
SPEEDTEST_SCHEDULE=0 */1 * * *

# Server Selection - Speedtest server preferences
# SPEEDTEST_SERVERS=52365,36998  # Comma-separated list of server IDs to use
# SPEEDTEST_BLOCKED_SERVERS=  # Comma-separated list of server IDs to avoid
# SPEEDTEST_INTERFACE=eth0  # Network interface to use for tests
# SPEEDTEST_CHECKINTERNET_URL=https://www.google.com  # URL to check internet connectivity

# Skip tests for specific IPs - Useful when connected via VPN
# SPEEDTEST_SKIP_IPS=127.0.0.1,192.168.0.0/16  # Skip tests when these IPs are detected

# ===================================================================
# THRESHOLDS (Performance monitoring - Set during initial setup)
# ===================================================================

THRESHOLD_ENABLED=true  # Enable threshold monitoring for alerts
THRESHOLD_DOWNLOAD=900  # Minimum download speed (Mbps) before alert
THRESHOLD_UPLOAD=900  # Minimum upload speed (Mbps) before alert
THRESHOLD_PING=25  # Maximum ping (ms) before alert

# ===================================================================
# DATA MANAGEMENT
# ===================================================================

# Prune old results - Automatically delete results older than X days (0 = disabled)
# PRUNE_RESULTS_OLDER_THAN=30  # Keep results for 30 days, delete older ones

# ===================================================================
# API CONFIGURATION
# ===================================================================

API_RATE_LIMIT=60  # Maximum API requests per minute per IP

# ===================================================================
# CHART & DISPLAY CONFIGURATION
# ===================================================================

CHART_BEGIN_AT_ZERO=true  # Start chart Y-axis at zero instead of data minimum
CHART_DATETIME_FORMAT=j/m G:i  # DateTime format in charts (PHP date format)
DATETIME_FORMAT=j M Y, G:i:s  # DateTime format in tables (PHP date format)

# ===================================================================
# NOTIFICATIONS (Configure in web UI after setup)
# ===================================================================

# Database notifications are enabled by default
# Configure email/webhook notifications through the web interface after initial setup
# Supported notification channels: Database, Mail, Webhook
