# Readarr (Bookshelf Fork) Environment Configuration
# Image: ghcr.io/pennydreadful/bookshelf:hardcover
# Source: https://github.com/pennydreadful/bookshelf
#         https://wiki.servarr.com/readarr/environment-variables
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────
# Bookshelf is built on linuxserver/baseimage-alpine, same LSIO pattern

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Umask for new files/directories created by the container (optional)
#UMASK=022

# Docker Mods — pipe-separated list of LinuxServer mod images (optional)
#DOCKER_MODS=

# ── Servarr Override Variables (READARR__NAMESPACE__KEY) ───────────────────────
# Bookshelf uses the READARR prefix (same lineage as Readarr)

# Server port (default: 8787)
#READARR__SERVER__PORT=8787

# URL base path for reverse proxy (e.g., /readarr)
#READARR__SERVER__URLBASE=

# Bind address (default: *)
#READARR__SERVER__BINDADDRESS=*

# API key (auto-generated on first run if not set)
#READARR__AUTH__APIKEY=

# Authentication method: None, Basic, Forms, External
#READARR__AUTH__METHOD=Forms

# Authentication required: Enabled, DisabledForLocalAddresses
#READARR__AUTH__REQUIRED=Enabled

# Log level: info, debug, trace
#READARR__LOG__LEVEL=info

# Instance name shown in the UI
#READARR__APP__INSTANCENAME=Readarr

# UI theme: auto, dark, light
#READARR__APP__THEME=auto

# ── Bookshelf-specific Variables ──────────────────────────────────────────────

# Metadata provider URL (Hardcover metadata API)
# Default is baked into the image: https://api.bookinfo.pro
# For self-hosted metadata: set to your rreading-glasses instance URL
# For shared public instance: https://hardcover.bookinfo.pro
# Configure in UI: Settings → Development → Metadata Provider Source
#METADATA_URL=https://api.bookinfo.pro

# ── PostgreSQL Backend (optional, default is SQLite) ──────────────────────────
#READARR__POSTGRES__HOST=10.0.2.2
#READARR__POSTGRES__PORT=5432
#READARR__POSTGRES__USER=readarr
#READARR__POSTGRES__PASSWORD=changeme
#READARR__POSTGRES__MAINDB=readarr-main
#READARR__POSTGRES__LOGDB=readarr-log

# ── SSL (optional) ───────────────────────────────────────────────────────────
#READARR__SERVER__ENABLESSL=false
#READARR__SERVER__SSLPORT=6969

# ── Update Settings ──────────────────────────────────────────────────────────
#READARR__UPDATE__MECHANISM=Docker
#READARR__UPDATE__AUTOMATICALLY=false
#READARR__UPDATE__BRANCH=develop
