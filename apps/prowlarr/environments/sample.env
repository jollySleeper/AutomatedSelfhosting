# Prowlarr Environment Configuration
# Source: https://docs.linuxserver.io/images/docker-prowlarr/
#         https://wiki.servarr.com/prowlarr/environment-variables
# Copy this file to local.env and override only the values you need.

# ── LinuxServer.io Base Variables ──────────────────────────────────────────────

# User/Group IDs — match your host user for correct file ownership
PUID=1000
PGID=1000

# Timezone (tz database name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Etc/UTC

# Umask for new files/directories created by the container (optional)
#UMASK=022

# Docker Mods — pipe-separated list of LinuxServer mod images (optional)
# See: https://linuxserver.github.io/docker-mods/
#DOCKER_MODS=

# ── Servarr Override Variables (PROWLARR__NAMESPACE__KEY) ──────────────────────
# These override values in config.xml. Restart required after changes.
# Format: PROWLARR__<NAMESPACE>__<KEY>

# Server port (default: 9696)
# Override to match your external port mapping for Host header validation
#PROWLARR__SERVER__PORT=9696

# URL base path for reverse proxy (e.g., /prowlarr)
#PROWLARR__SERVER__URLBASE=

# Bind address (default: *)
#PROWLARR__SERVER__BINDADDRESS=*

# API key (auto-generated on first run if not set)
#PROWLARR__AUTH__APIKEY=

# Authentication method: None, Basic, Forms, External
#PROWLARR__AUTH__METHOD=Forms

# Authentication required: Enabled, DisabledForLocalAddresses
#PROWLARR__AUTH__REQUIRED=Enabled

# Log level: info, debug, trace
#PROWLARR__LOG__LEVEL=info

# Instance name shown in the UI
#PROWLARR__APP__INSTANCENAME=Prowlarr

# UI theme: auto, dark, light
#PROWLARR__APP__THEME=auto

# ── PostgreSQL Backend (optional, default is SQLite) ──────────────────────────
# Uncomment to use PostgreSQL instead of the default SQLite database

#PROWLARR__POSTGRES__HOST=10.0.2.2
#PROWLARR__POSTGRES__PORT=5432
#PROWLARR__POSTGRES__USER=prowlarr
#PROWLARR__POSTGRES__PASSWORD=changeme
#PROWLARR__POSTGRES__MAINDB=prowlarr-main
#PROWLARR__POSTGRES__LOGDB=prowlarr-log

# ── SSL (optional) ───────────────────────────────────────────────────────────
#PROWLARR__SERVER__ENABLESSL=false
#PROWLARR__SERVER__SSLPORT=6969
#PROWLARR__SERVER__SSLCERTPATH=
#PROWLARR__SERVER__SSLCERTPASSWORD=

# ── Update Settings ──────────────────────────────────────────────────────────
#PROWLARR__UPDATE__MECHANISM=Docker
#PROWLARR__UPDATE__AUTOMATICALLY=false
#PROWLARR__UPDATE__BRANCH=main
