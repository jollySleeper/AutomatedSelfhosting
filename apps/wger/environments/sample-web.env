# wger Workout Manager - Web Environment Configuration
# Image: docker.io/wger/server
# Source: https://wger.readthedocs.io/en/latest/production/docker.html
# Copy this file to wger-web.env and override only the values you need.

# ── Security (REQUIRED — change in production!) ──────────────────────────────

# Django's secret key (50+ character random string)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=changeme-generate-a-random-50-char-string

# JWT signing key (use something different from SECRET_KEY)
#SIGNING_KEY=changeme-different-from-secret-key

# ── Timezone ──────────────────────────────────────────────────────────────────

TIME_ZONE=Etc/UTC
TZ=Etc/UTC
VITE_TIME_ZONE=Etc/UTC

# ── CSRF & Allowed Hosts ─────────────────────────────────────────────────────

# Comma-separated trusted origins for CSRF protection
# Set your domain(s) here to avoid CSRF errors behind reverse proxy
CSRF_TRUSTED_ORIGINS=http://wger.example.com
X_FORWARDED_PROTO_HEADER_SET=True

# Comma-separated allowed hostnames
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,wger.example.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=wger
DJANGO_DB_USER=wger
DJANGO_DB_PASSWORD=changeme
DJANGO_DB_HOST=10.0.2.2
DJANGO_DB_PORT=5432
DJANGO_PERFORM_MIGRATIONS=True

# ── Cache (Redis) ─────────────────────────────────────────────────────────────

DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://10.0.2.2:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

# ── Celery (Redis) ────────────────────────────────────────────────────────────

USE_CELERY=True
CELERY_BROKER=redis://10.0.2.2:6379/2
CELERY_BACKEND=redis://10.0.2.2:6379/2

# ── Application Settings ─────────────────────────────────────────────────────

WGER_INSTANCE=https://wger.de
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=True
ALLOW_UPLOAD_VIDEOS=True
MIN_ACCOUNT_AGE_TO_TRUST=21

# ── Exercise Sync ────────────────────────────────────────────────────────────

SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
DOWNLOAD_INGREDIENTS_FROM=WGER
CACHE_API_EXERCISES_CELERY=True
CACHE_API_EXERCISES_CELERY_FORCE_UPDATE=False

# ── Server Settings ──────────────────────────────────────────────────────────

DJANGO_DEBUG=False
WGER_USE_GUNICORN=True
EXERCISE_CACHE_TTL=18000
SITE_URL=http://wger.example.com
SERVE_STATIC_FILES=True

# ── JWT Auth ──────────────────────────────────────────────────────────────────

ACCESS_TOKEN_LIFETIME=10
REFRESH_TOKEN_LIFETIME=24

# ── Brute Force Protection ───────────────────────────────────────────────────

AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_FORWARDED_FOR,REMOTE_ADDR

# ── Gunicorn ──────────────────────────────────────────────────────────────────

GUNICORN_CMD_ARGS="--workers 4 --threads 2 --worker-class gthread --preload --timeout 240"

# ── Logging ──────────────────────────────────────────────────────────────────

LOG_LEVEL_PYTHON=INFO

# ── Auth Proxy (optional) ─────────────────────────────────────────────────────
#AUTH_PROXY_HEADER=
#AUTH_PROXY_TRUSTED_IPS=
#AUTH_PROXY_CREATE_UNKNOWN_USER=False

# ── Email (optional) ─────────────────────────────────────────────────────────
#ENABLE_EMAIL=False
#EMAIL_HOST=email.example.com
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=True

# ── reCAPTCHA (optional) ─────────────────────────────────────────────────────
USE_RECAPTCHA=False
#RECAPTCHA_PUBLIC_KEY=
#RECAPTCHA_PRIVATE_KEY=

# ── Performance ──────────────────────────────────────────────────────────────
COMPRESS_ENABLED=True
NUMBER_OF_PROXIES=1
DJANGO_CLEAR_STATIC_FIRST=False

# ── Prometheus (optional) ─────────────────────────────────────────────────────
EXPOSE_PROMETHEUS_METRICS=False
