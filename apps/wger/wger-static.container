[Unit]
Description=wger-static

[Container]
AutoUpdate=registry
ContainerName=wger-static
Image=docker.io/nginx:alpine
PublishPort=127.0.0.1:8052:80
Volume=%h/selfhost/apps/wger/volumes/wger-web/static:/usr/share/nginx/html/static:ro
Volume=%h/selfhost/apps/wger/volumes/wger-web/media:/usr/share/nginx/html/media:ro
Volume=%h/selfhost/apps/wger/wger-static-nginx.conf:/etc/nginx/conf.d/default.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
