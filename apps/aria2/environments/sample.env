# Aria2 Pro Environment Configuration
# Image: p3terx/aria2-pro
# Source: https://github.com/P3TERX/Aria2-Pro-Docker
# Copy this file to local.env and override only the values you need.

# ── User/Group IDs ────────────────────────────────────────────────────────────

# Host user/group IDs for file ownership on downloads and config
# If both are empty or set to 65534, permission hardening is skipped
PUID=1000
PGID=1000

# Timezone (tz database name)
TZ=Etc/UTC

# Umask for new files (default: 022 if not set)
#UMASK_SET=022

# ── RPC Settings ──────────────────────────────────────────────────────────────

# RPC authorization secret token — CHANGE THIS from the default
# Clients (AriaNg, etc.) must use this token to connect
# Default if not set: P3TERX (from bundled profile)
RPC_SECRET=changeme

# RPC listen port (default: 6800)
RPC_PORT=6800

# ── BitTorrent Settings ──────────────────────────────────────────────────────

# TCP listen port for BitTorrent and DHT (default: 6888)
LISTEN_PORT=6888

# Disk cache size for reducing disk I/O (e.g., 64M, 128M)
# Default: empty (aria2 default ~16M)
#DISK_CACHE=64M

# ── IPv6 Settings ─────────────────────────────────────────────────────────────

# Enable IPv6 mode: true/enable or false/disable
# When enabled: disable-ipv6=false, enable-dht6=true
#IPV6_MODE=false

# ── Tracker Settings ─────────────────────────────────────────────────────────

# Auto-update tracker list on startup (default: true)
# Set to false/disable to skip tracker updates
#UPDATE_TRACKERS=true

# Custom tracker list URL(s), comma-separated
# Default: uses https://trackerslist.com/all_aria2.txt with fallbacks
#CUSTOM_TRACKER_URL=

# ── Special Modes ────────────────────────────────────────────────────────────

# Special download completion handling:
#   rclone — install rclone, use upload.sh on complete
#   move   — use move.sh on complete
#   (empty) — use clean.sh (default)
#SPECIAL_MODE=

# Rclone config path (only used with SPECIAL_MODE=rclone)
#RCLONE_CONFIG=/config/rclone.conf
